---
layout: base.njk
---
<main class="container my-5">
  <div class="row">
    <aside class="col-lg-4 mb-5">
      <div class="bg-white p-4 rounded shadow-sm text-center border h-card">
        <img src="{{ image or '/images/thenewpolis-logo.png' }}"
             class="u-photo rounded-circle mb-4 shadow"
             width="150"
             height="150"
             alt="{{ author or title }}"
             style="object-fit: cover;">

        <h2 class="serif fw-bold p-name">{{ author or title }}</h2>

        <p class="text-muted small text-uppercase fw-bold border-bottom pb-3 mb-3 p-org">
          {{ affiliation or affilation or "Contributor" }}
        </p>

        <p class="text-secondary small mb-4 p-note">
          {{ bio or "Academic contributor to The New Polis, focusing on critical theory and political theology." }}
        </p>
        <a class="u-url d-none" href="{{ page.url }}">{{ page.url | absUrl(metadata.url) }}</a>
      </div>
    </aside>

    <div class="col-lg-8 ps-lg-5">
      <h3 class="serif fw-bold mb-4 border-bottom pb-2">Articles by {{ author or title }}</h3>
      {% set authoredPosts = collections.posts | filterByAuthor(author or title) | sortByDateDesc %}
      {% if authoredPosts.length > 0 %}
        <div class="row g-4">
          {% for post in authoredPosts %}
          <div class="col-md-6">
            <div class="card h-100 bg-white border-0 shadow-sm transition-hover">
              <div style="height: 160px; overflow: hidden;">
                <img src="{{ post.data.image or metadata.image }}"
                     class="card-img-top w-100 h-100"
                     loading="lazy"
                     alt="{{ post.data.title }}"
                     style="object-fit: cover;">
              </div>
              <div class="card-body p-3">
                <h5 class="serif fw-bold h6 mb-2">
                  <a href="{{ post.url }}" class="text-dark text-decoration-none stretched-link">
                    {{ post.data.title }}
                  </a>
                </h5>
                <p class="small text-muted mb-0">{{ post.date | readableDate }}</p>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="alert alert-light border">
          No posts found for this author yet.
        </div>
      {% endif %}
    </div>
  </div>
</main>
