---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="https://www.sitemaps.org/schemas/sitemap/0.9">
  {% set baseUrl = metadata.url | baseUrl %}
  {%- for page in collections.sitemapEntries %}
  <url>
    <loc>{{ page.url | absUrl(baseUrl) }}</loc>
    {%- if page.date %}
    <lastmod>{{ page.date | htmlDateString }}</lastmod>
    {%- endif %}
    <changefreq>monthly</changefreq>
    <priority>{% if page.url == "/" %}1.0{% elif page.url.startsWith("/feed/") %}0.9{% elif page.url.startsWith("/20") %}0.8{% else %}0.5{% endif %}</priority>
  </url>
  {%- endfor %}
</urlset>
