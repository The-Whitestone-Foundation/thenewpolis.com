{
  "name": "thenewpolis.com",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "eleventy --serve --incremental",
    "start": "npm run dev",
    "build": "npm run sequoia:stage && rm -rf _site && eleventy && npm run build:search",
    "build:search": "pagefind --site _site --glob \"**/*.html\"",
    "sequoia:stage": "node scripts/build-sequoia-content.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "4.0.0-alpha.10",
    "@zachleat/heading-anchors": "^1.0.5",
    "eleventy-plugin-toc": "^1.1.5",
    "js-yaml": "^4.3.0",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "pagefind": "^1.5.2"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.14.0"
  },
  "packageManager": "npm@11.14.0",
  "overrides": {
    "undici": "~7.28.0"
  }
}
